<Window x:Class="Hanouty.Desktop.Wpf.InventoryCountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HANOUTY — Inventaire physique" Width="980" Height="690"
        MinWidth="740" MinHeight="540" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Inventaire physique" FontSize="26" FontWeight="SemiBold"/>
            <TextBlock Text="Ouvrir le document, saisir le stock compté, vérifier les écarts puis confirmer."
                       Margin="0,4,0,14" TextWrapping="Wrap"/>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Ouvrir le document" MinHeight="42" Padding="18,6"
                        IsEnabled="{Binding CanOpen}" Click="Open_Click" AutomationProperties.Name="Open inventory document"/>
                <TextBox Text="{Binding DocumentId, UpdateSourceTrigger=PropertyChanged}" MinHeight="42"
                         Margin="0,0,10,0" Padding="8" AutomationProperties.Name="Inventory document identity"/>
            </DockPanel>
            <TextBlock Text="{Binding CountProgress}" FontWeight="SemiBold" Margin="0,4,0,4"
                       AutomationProperties.Name="Inventory counted remaining and difference summary"/>
            <TextBlock Text="{Binding Status}" Margin="0,10,0,14" TextWrapping="Wrap"
                       AutomationProperties.Name="Inventory status"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="190"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding ArticleId, UpdateSourceTrigger=PropertyChanged}"
                         Padding="8" MinHeight="42" Margin="0,0,10,0" AutomationProperties.Name="Counted article identity"/>
                <TextBox Grid.Column="1" Text="{Binding PhysicalText, UpdateSourceTrigger=PropertyChanged}"
                         Padding="8" MinHeight="42" Margin="0,0,10,0" AutomationProperties.Name="Physical stock quantity"/>
                <Button Grid.Column="2" Content="Enregistrer comptage" MinHeight="42" Click="Record_Click"
                        IsEnabled="{Binding CanRecord}" AutomationProperties.Name="Record physical quantity"/>
            </Grid>
            <Button Content="CONFIRMER LE DOCUMENT D'INVENTAIRE" MinHeight="54" Margin="0,12,0,0"
                    FontWeight="Bold" Click="Confirm_Click" IsEnabled="{Binding CanConfirm}"
                    AutomationProperties.Name="Confirm inventory document"/>
        </StackPanel>
        <DataGrid x:Name="InventoryLinesGrid" ItemsSource="{Binding Lines}" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="CountLine_Selected"
                  AutomationProperties.Name="Inventory count and differences">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Article" Binding="{Binding ArticleName}" Width="*"/>
                <DataGridTextColumn Header="ID" Binding="{Binding ArticleId}" Width="120"/>
                <DataGridTextColumn Header="Stock théorique" Binding="{Binding ExpectedQuantity}" Width="140"/>
                <DataGridTextColumn Header="Stock physique" Binding="{Binding PhysicalQuantity}" Width="140"/>
                <DataGridTextColumn Header="Écart" Binding="{Binding Difference}" Width="110"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
