<Window x:Class="Hanouty.Desktop.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HANOUTY POS — Caisse" Height="760" Width="1280"
        MinHeight="480" MinWidth="760" WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <Window.Resources><BooleanToVisibilityConverter x:Key="BoolVisibility"/></Window.Resources>
    <DockPanel Margin="20" FlowDirection="{Binding LayoutDirection}">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <DockPanel>
                <WrapPanel DockPanel.Dock="Right">
                    <Button Content="Fond de caisse" Click="SetOpeningCash_Click" MinHeight="36" Padding="12,4"
                            Margin="0,0,8,0" IsEnabled="{Binding FinancialSessionActive}"/>
                    <Button Content="Clôture de caisse" Click="CountCashDrawer_Click" MinHeight="36" Padding="12,4"
                            IsEnabled="{Binding FinancialSessionActive}"/>
                </WrapPanel>
                <TextBlock Text="Hanouty POS" FontSize="28" FontWeight="SemiBold"/>
            </DockPanel>
            <WrapPanel Margin="0,8,0,0" AutomationProperties.Name="Sections HANOUTY">
                <RadioButton x:Name="SalesSection" GroupName="HanoutySection" Content="Vente" IsChecked="True"
                             MinHeight="36" Padding="12,4" Margin="0,0,8,0"/>
                <RadioButton x:Name="ReturnsSection" GroupName="HanoutySection" Content="Retours"
                             MinHeight="36" Padding="12,4" Margin="0,0,8,0"/>
                <Button Content="Inventaire physique" Click="OpenInventory_Click" HorizontalAlignment="Left"
                        MinHeight="36" Padding="12,4" Margin="0,0,8,0" AutomationProperties.Name="Open physical inventory workflow"/>
                <Button Content="Réception fournisseur" Click="OpenPurchaseReceipt_Click" HorizontalAlignment="Left"
                        IsEnabled="{Binding FinancialSessionActive}" MinHeight="36" Padding="12,4" Margin="0,0,8,0"
                        AutomationProperties.Name="Open purchase receipt"/>
                <Button Content="Prix du catalogue" Click="OpenCataloguePrices_Click" HorizontalAlignment="Left"
                        IsEnabled="{Binding FinancialSessionActive}" MinHeight="36" Padding="12,4" Margin="0,0,8,0"
                        AutomationProperties.Name="Open catalogue prices"/>
            </WrapPanel>
            <CheckBox Content="Right-to-left layout" IsChecked="{Binding IsRightToLeft, Mode=TwoWay}" Margin="0,8,0,0" AutomationProperties.Name="Right-to-left layout"/>
            <TextBlock Text="Offline desktop — checkout requires registered authorized local services"
                       Foreground="DimGray" Margin="0,4,0,0"/>
        </StackPanel>
        <Grid>
            <ScrollViewer Visibility="{Binding IsChecked, ElementName=ReturnsSection, Converter={StaticResource BoolVisibility}}"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="600" HorizontalAlignment="Stretch" Margin="8">
                        <TextBlock Text="Retour de vente" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,18"/>
                        <TextBlock Text="Numéro du ticket" Margin="0,0,0,6"/>
                        <TextBox x:Name="OriginalSaleSearch" MinHeight="36" TextChanged="OriginalSaleSearch_TextChanged"
                                 AutomationProperties.Name="Search original receipt identity"/>
                        <Button Content="Rechercher le ticket" Click="SearchOriginalSales_Click"
                                MinHeight="40" Margin="0,6,0,6"/>
                        <ListBox x:Name="OriginalSaleResults" SelectionChanged="OriginalSaleResults_SelectionChanged" DisplayMemberPath="ReceiptLabel"
                                 Height="80" AutomationProperties.Name="Persisted original sale results"/>
                        <Button Content="Vérifier le ticket sélectionné" Click="SelectOriginalSale_Click"
                                MinHeight="40" Margin="0,6,0,6"/>
                        <TextBlock Text="Le remboursement porte sur le ticket complet."
                                   Margin="0,8,0,4" TextWrapping="Wrap"/>
                        <Button Content="Rembourser le ticket en espèces" Click="ConfirmReturnDraft_Click"
                                MinHeight="44" Margin="0,4,0,4"/>
                        <TextBlock x:Name="ReturnDraftStatus" Text="Sélectionnez un ticket"
                                   TextWrapping="Wrap" AutomationProperties.Name="Return draft status"/>
                        <TextBlock x:Name="OriginalSaleStatus" Text="Aucun ticket sélectionné"
                                   TextWrapping="Wrap" AutomationProperties.Name="Original sale review status"/>
                    </StackPanel>
            </ScrollViewer>
            <Grid Visibility="{Binding IsChecked, ElementName=SalesSection, Converter={StaticResource BoolVisibility}}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,18,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Catalogue" FontWeight="SemiBold" FontSize="18" VerticalAlignment="Center"/>
                        <Button Content="Actualiser" Command="{Binding ReloadCommand}" Margin="16,0,0,0" Padding="12,6" MinHeight="40" AutomationProperties.Name="Reload local catalogue"/>
                    </StackPanel>
                    <Label Content="_Code-barres" Target="{Binding ElementName=ScannerInput}" Padding="0"
                           Margin="0,10,0,4"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Ajouter" Command="{Binding ScanCommand}"
                                MinWidth="86" MinHeight="40" Margin="8,0,0,0"
                                AutomationProperties.Name="Scan barcode"/>
                        <TextBox x:Name="ScannerInput" Text="{Binding ScannerText, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8" MinHeight="40"
                                 AutomationProperties.Name="Barcode scanner input" IsEnabled="{Binding CanSelectProduct}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding ScanCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                    </DockPanel>
                    <TextBlock Text="{Binding ScanFeedback}" Margin="0,6,0,8" TextWrapping="Wrap"
                               AutomationProperties.Name="Barcode result"/>
                    <Label Content="_Rechercher un article" Target="{Binding ElementName=CatalogueSearch}" Padding="0"
                           Margin="0,0,0,4"/>
                    <TextBox x:Name="CatalogueSearch" Margin="0,0,0,8" Padding="8" MinHeight="40"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Search catalogue"/>
                    <TextBlock Text="Choisissez l’article correspondant à ce code-barres." Margin="0,4,0,4"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasBarcodeAmbiguity, Converter={StaticResource BoolVisibility}}"/>
                    <ListBox ItemsSource="{Binding BarcodeCandidates}" Height="90" DisplayMemberPath="Name"
                             Visibility="{Binding HasBarcodeAmbiguity, Converter={StaticResource BoolVisibility}}"
                             SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                             AutomationProperties.Name="Barcode candidates">
                        <ListBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SelectCommand}"/>
                        </ListBox.InputBindings>
                    </ListBox>
                    <Button Content="Ajouter l’article sélectionné" Command="{Binding SelectCommand}"
                            Visibility="{Binding HasBarcodeAmbiguity, Converter={StaticResource BoolVisibility}}"
                            MinHeight="44" Margin="0,4,0,8" Padding="12,8"
                            AutomationProperties.Name="Choose barcode variant" IsEnabled="{Binding CanSelectProduct}"/>
                    <DataGrid ItemsSource="{Binding VisibleProducts}" AutoGenerateColumns="False"
                              IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow"
                              SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                              AutomationProperties.Name="Product list" MouseDoubleClick="ProductList_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Article" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Code-barres" Binding="{Binding Barcode}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="Articles avec photo" Margin="0,12,0,6" FontWeight="SemiBold"/>
                    <ScrollViewer Height="132" VerticalScrollBarVisibility="Auto"
                                  AutomationProperties.Name="Products with photos">
                        <ItemsControl ItemsSource="{Binding PhotoProducts}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button MinWidth="108" MinHeight="112" Padding="6" Margin="3"
                                            Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="{Binding Name}"
                                            IsEnabled="{Binding DataContext.CanSelectProduct, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <StackPanel Width="96">
                                            <Image Source="{Binding ImagePath}" Width="80" Height="72" Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                       HorizontalAlignment="Center" MaxWidth="96"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
                <DockPanel Grid.Column="1" LastChildFill="True">
                    <Border DockPanel.Dock="Bottom" Padding="12" Margin="0,12,0,0" BorderThickness="1" BorderBrush="#B9C5D1" Background="#F2F6FA" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="TOTAL À ENCAISSER · MAD" FontWeight="Bold" FontSize="16"/>
                            <TextBlock x:Name="TrustedBasketTotal" Text="Total indisponible — actualiser depuis le Host" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,8" AutomationProperties.Name="Trusted basket total MAD"/>
                            <Button Content="Actualiser le total du panier" Click="RefreshTrustedBasketTotal_Click" MinHeight="40" AutomationProperties.Name="Read trusted basket total"/>
                            <Button Content="ENCAISSER · PAIEMENT" Command="{Binding CommitCommand}" IsEnabled="{Binding CanCommit}" MinHeight="58" FontSize="17" FontWeight="Bold" Margin="0,10,0,0" AutomationProperties.Name="Complete checkout"/>
                                </StackPanel>
                    </Border>
                    <ScrollViewer x:Name="CashierWorkflowScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="True" AutomationProperties.Name="Cashier workflow scroll region">
                    <StackPanel Margin="0,0,8,0">
                    <GroupBox Header="Panier" Margin="0,0,0,12" AutomationProperties.Name="Current Host basket">
                        <DockPanel Margin="8">
                            <TextBlock DockPanel.Dock="Bottom" Text="{Binding BasketStatus}" Foreground="DimGray" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                                <Button Content="−" Click="DecreaseBasketQuantity_Click" MinWidth="44" MinHeight="36"
                                        Margin="0,0,6,0" AutomationProperties.Name="Diminuer la quantité"/>
                                <Button Content="+" Click="IncreaseBasketQuantity_Click" MinWidth="44" MinHeight="36"
                                        Margin="0,0,6,0" AutomationProperties.Name="Augmenter la quantité"/>
                                <Button Content="Retirer" Click="RemoveBasketLine_Click" MinHeight="36"/>
                            </StackPanel>
                            <DataGrid x:Name="CashierBasket" SelectionMode="Single" ItemsSource="{Binding BasketLines}" AutoGenerateColumns="False" IsReadOnly="True"
                                      CanUserAddRows="False" MinHeight="140" MaxHeight="280" AutomationProperties.Name="Basket article quantity price">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Article" Binding="{Binding ArticleName}" Width="*"/>
                                    <DataGridTextColumn Header="Qté" Binding="{Binding Quantity}" Width="70"/>
                                    <DataGridTextColumn Header="Prix MAD" Binding="{Binding UnitPriceMad, StringFormat={}{0:F2}}" Width="95"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </GroupBox>
                    <TextBlock Text="Selected product" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding SelectedProduct.Name, TargetNullValue=No product selected}"
                               Margin="0,12,0,6" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding SelectedProduct.Barcode, TargetNullValue=—}"/>
                    <Button Content="Select product" Command="{Binding SelectCommand}" MinHeight="44"
                            Padding="12,8" Margin="0,18,0,0"
                            AutomationProperties.Name="Select product" IsEnabled="{Binding CanSelectProduct}"/>
                    <TextBlock Text="Authorized cashier / payment context" FontWeight="SemiBold" Margin="0,16,0,4"/>
                    <Button Content="Enter cashier / register / cash tender" Click="CashierEntry_Click" MinHeight="44" Padding="12,8" Margin="0,8,0,8" AutomationProperties.Name="Enter cashier and fresh cash tender"/>
                    <Button Content="End cashier session" Click="EndFinancialSession_Click" MinHeight="40"
                            AutomationProperties.Name="End cashier session"/>
                    <TextBlock Text="{Binding PaymentContext.CashierId, TargetNullValue=No authorized cashier}" AutomationProperties.Name="Cashier identity" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding PaymentContext.RegisterId, TargetNullValue=No register}" AutomationProperties.Name="Register identity" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding PaymentContext.TenderCode, TargetNullValue=No tender}" AutomationProperties.Name="Tender type"/>
                    <TextBlock Text="{Binding PaymentContext.TenderedAmount, StringFormat='Tendered: {0:N2}'}" AutomationProperties.Name="Tendered amount"/>
                    <TextBlock Text="Payment remains disabled until an authorized contextual adapter and trusted cashier session are registered." TextWrapping="Wrap" Foreground="DimGray" Margin="0,6,0,0"/>
                    <TextBlock Text="{Binding PendingOperationId, StringFormat='Operation: {0}'}" TextWrapping="Wrap" AutomationProperties.Name="Pending operation identity" Margin="0,8,0,0"/>
                    <Button Content="Check durable checkout status" Command="{Binding ReconcileCommand}" IsEnabled="{Binding CheckoutUncertain}" MinHeight="44" Padding="12,8" Margin="0,8,0,0" AutomationProperties.Name="Reconcile uncertain checkout"/>
                    <Button Content="Review result and start a new basket" Click="ReviewResolvedCheckout_Click"
                            IsEnabled="{Binding CanReviewResolvedCheckout}" MinHeight="44" Padding="12,8" Margin="0,8,0,0"
                            AutomationProperties.Name="Review resolved checkout with cashier PIN"/>
                    <TextBlock Text="{Binding CommitFeedback}" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.Name="Checkout result"/>
                    <TextBlock Text="Stock posting, printing and licensing require separately verified application contracts."
                               Margin="0,22,0,0" TextWrapping="Wrap" Foreground="DimGray"/>
                    </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
