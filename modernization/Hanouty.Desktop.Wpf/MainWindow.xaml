<Window x:Class="Hanouty.Desktop.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hanouty POS V2.0 — Desktop" Height="650" Width="1080"
        MinHeight="480" MinWidth="760" WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <DockPanel Margin="20" FlowDirection="{Binding LayoutDirection}">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="Hanouty POS" FontSize="28" FontWeight="SemiBold"/>
            <CheckBox Content="Right-to-left layout" IsChecked="{Binding IsRightToLeft, Mode=TwoWay}" Margin="0,8,0,0" AutomationProperties.Name="Right-to-left layout"/>
            <TextBlock Text="Offline desktop preview — no sales or inventory writes"
                       Foreground="DimGray" Margin="0,4,0,0"/>
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,18,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Catalogue" FontWeight="SemiBold" FontSize="18" VerticalAlignment="Center"/>
                    <Button Content="Reload local catalogue" Command="{Binding ReloadCommand}" Margin="16,0,0,0" Padding="12,6" MinHeight="40" AutomationProperties.Name="Reload local catalogue"/>
                </StackPanel>
                <TextBlock Text="{Binding ScanFeedback}" AutomationProperties.Name="Catalogue status" Foreground="DimGray" Margin="0,4,0,4"/>
                <TextBox Margin="0,10,0,10" Padding="8" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Search catalogue"/>
                <TextBlock Text="Scanner / barcode" Margin="0,0,0,5"/>
                <TextBox Text="{Binding ScannerText, UpdateSourceTrigger=PropertyChanged}" Padding="8"
                         AutomationProperties.Name="Barcode scanner input">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding ScanCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
                <TextBlock Text="{Binding ScanFeedback}" Margin="0,6,0,10"
                           AutomationProperties.Name="Barcode result"/>
                <TextBlock Text="Barcode matches — select explicitly when barcode is shared" Margin="0,4,0,4"/>
                <ListBox ItemsSource="{Binding BarcodeCandidates}" Height="65" DisplayMemberPath="Name"
                         SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                         AutomationProperties.Name="Barcode candidates"/>
                <DataGrid ItemsSource="{Binding VisibleProducts}" AutoGenerateColumns="False"
                          IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow"
                          SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                          AutomationProperties.Name="Product list">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Article" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="Image-backed products" Margin="0,12,0,6" FontWeight="SemiBold"/>
                <ScrollViewer Height="132" VerticalScrollBarVisibility="Auto"
                              AutomationProperties.Name="Products with photos">
                    <ItemsControl ItemsSource="{Binding PhotoProducts}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button MinWidth="108" MinHeight="112" Padding="6" Margin="3"
                                        Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        AutomationProperties.Name="{Binding Name}">
                                    <StackPanel Width="96">
                                        <Image Source="{Binding ImagePath}" Width="80" Height="72" Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                   HorizontalAlignment="Center" MaxWidth="96"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="Selected product" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding SelectedProduct.Name, TargetNullValue=No product selected}"
                           Margin="0,12,0,6" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding SelectedProduct.Barcode, TargetNullValue=—}"/>
                <Button Content="Select product" Command="{Binding SelectCommand}" MinHeight="44"
                        Padding="12,8" Margin="0,18,0,0"
                        AutomationProperties.Name="Select product"/>
                <TextBlock Text="Checkout, stock posting, printing and licensing are disabled until their application contracts are integrated and verified."
                           Margin="0,22,0,0" TextWrapping="Wrap" Foreground="DimGray"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
